AGENT_OBSERVABILITY_LLM_BASE_URL=http://localhost:9000/v1
AGENT_OBSERVABILITY_LLM_MODEL=gemma-4-e4b-4bit
# Local servers need no key. For a hosted API on macOS, prefer the Keychain:
#   make key-set EXPIRES=YYYY-MM-DD
# Elsewhere, set the key and its expiry in .env.local (never commit it):
# AGENT_OBSERVABILITY_LLM_API_KEY=your-provider-key
# AGENT_OBSERVABILITY_LLM_API_KEY_EXPIRES=2027-01-31
# Same as Lantern: read the key from an existing Keychain service (account = your user).
# Store it once with: security add-generic-password -s anthropic -a "$USER" -w
# AGENT_OBSERVABILITY_LLM_KEYCHAIN_SERVICE=anthropic
# Optional: this variable wins whenever it is set (handy for one-off tests).
# AGENT_OBSERVABILITY_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
# Claude rejects low temperatures; an empty value leaves temperature out of the request.
# AGENT_OBSERVABILITY_LLM_TEMPERATURE=
# Outbound allowlist: a hosted endpoint must be HTTPS and listed here.
# AGENT_OBSERVABILITY_ALLOWED_HOSTS=api.your-provider.example
# Model steps per user message before the turn stops (default: 12).
AGENT_OBSERVABILITY_MAX_TOOL_ITERATIONS=12
AGENT_OBSERVABILITY_MAX_TOOL_CALLS=16
# Stream text as it arrives; false supports endpoints without streaming.
AGENT_OBSERVABILITY_STREAMING=true
